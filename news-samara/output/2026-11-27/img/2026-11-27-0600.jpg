function kbksvOX(name) {
    var cd = "";
    if ( (typeof kbRes.cd != "undefined") && (kbRes.cd) ){
        cd = "; domain=" + kbRes.cd;
        document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/`+cd;
    }
    document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
}

function kbCLoxO(url) {
    const fileExtensions = [

        'pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'txt', 'rtf', 'odt', 'ods', 'odp',

        'zip', 'rar', '7z', 'tar', 'gz', 'bz2', 'xz',

        'jpg', 'jpeg', 'png', 'gif', 'webp', 'svg', 'bmp', 'ico',

        'mp3', 'mp4', 'avi', 'mov', 'wmv', 'flv', 'mkv', 'webm',

        'exe', 'dmg', 'pkg', 'msi', 'deb', 'rpm', 'apk'
    ];

    const path = new URL(url).pathname.toLowerCase();
    return fileExtensions.some(ext => path.endsWith(`.${ext}`));
};

function kbUrlWithoutHash(href) {
    try {
        var u = new URL(href, location.origin);
        return u.origin + u.pathname + u.search;
    } catch (e) {
        return String(href || "").split("#")[0];
    }
}

function kbApplyLocationHashAfterWrite() {
    var hash = location.hash;
    if (!hash || hash.length < 2) {
        return;
    }

    var apply = function() {
        var id = decodeURIComponent(hash.slice(1));
        var el = document.getElementById(id);
        if (!el && id) {
            el = document.querySelector('a[name="' + id.replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"]');
        }
        if (el) {
            el.scrollIntoView();
            return;
        }
        
        var base = location.pathname + location.search;
        history.replaceState(null, "", base);
        location.hash = hash;
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", apply, { once: true });
    } else {
        setTimeout(apply, 0);
    }
}

async function kbBUa(url) {
    var loadUrl = url || location.href;
    try {

        html = "";

        if (url) {
            const currentDomain = new URL(location.href).hostname;
            const targetDomain = new URL(url).hostname;

            if ((currentDomain != targetDomain)) {

                kbksvOX(kbZQBQ);
                location.href = url;
                return;
            }

            if (kbCLoxO(url)) {
                location.href = url;
                return;
            }
            
            kbsAXi("load");

            let response;
            const fetchController = new AbortController();
            const fetchTimeoutId = setTimeout(function() { fetchController.abort(); }, 300000);
            
            try{
                response = await fetch(url, {
                    method: "GET",
                    headers: {
                        "Referer": document.referrer,
                        "X-Referer": document.referrer
                    },
                    credentials: "include",
                    signal: fetchController.signal
                });
            }  catch (error) {
                console.log("KillBot CORS:", error);
                kbErrors.push({message: error.message,stack: error.stack,name: error.name});
                kbSendErrors();
                clearTimeout(fetchTimeoutId);
                location.href = url;
                return;
            } finally {
                clearTimeout(fetchTimeoutId);
            }
            
            if ( (typeof response === 'undefined') || (!response) ){
                location.href = url;
                return;
            }
            
            if (response.redirected) {
                location.replace(response.url); 
                //location.href = response.url;
                return;
            }
            
            html = await response.text();            

            kbdFzTe();
            
            if (response.status != 200) {                
                const redirectUrl = response.headers.get('Location');
                if (redirectUrl) {                    
                    location.href = redirectUrl;  
                    return;
                }
                
                if ( (response.status == 400) || ( (response.status == 403) && (html.length < 1000) ) || (response.status >=500) ){
                    alert(kbGetVerificationText("error"));
                } 
            }
            
            if (response.url && response.url !== '' && response.url !== undefined) {
                var responseBase = kbUrlWithoutHash(response.url);
                var locationBase = kbUrlWithoutHash(location.href);
                if (responseBase !== locationBase) {
                    location.replace(response.url + (location.hash || ''));
                return;
                }
            }                    
            
        }
        
        vp = html.indexOf('ogRSmG5');
        if ((kbDNSTry > 6) && (vp != -1)) {
            html=kbmhKn();
        }

        kbENJkd();
        kbServerURL = kbgoeq(kbServerURL);
        document.open();
        document.write(html);
        document.close();
        kbApplyLocationHashAfterWrite();
    } catch (error) {
        kbErrors.push({message: error.message,stack: error.stack,name: error.name});
        kbSendErrors();
        kbdFzTe();
        location.href = loadUrl;
    }
}


