function kbbsALl(entry) {
    if (!entry) return entry;
    entry = String(entry).trim();
    if (entry.charAt(0) === '/') {
        var origin = (location.protocol + '//' + location.host).replace(/\/+$/, '');
        if (entry === '/') {
            return origin;
        }
        return origin + entry;
    }
    return entry.replace(/\/+$/, '');
}

function kbLwmys(servers) {
    if (!servers || !servers.length) return [];
    var out = [];
    for (var i = 0; i < servers.length; i++) {
        var url = kbbsALl(servers[i]);
        if (url) out.push(url);
    }
    return out;
}

function kbMrdl(url) {
    try {
        var u = String(url || '').trim();
        if (!u) return '';
        if (u.charAt(0) === '/') {
            return (location.hostname || '').toLowerCase();
        }
        if (u.indexOf('://') === -1) {
            u = location.protocol + '//' + u;
        }
        return new URL(u).hostname.toLowerCase();
