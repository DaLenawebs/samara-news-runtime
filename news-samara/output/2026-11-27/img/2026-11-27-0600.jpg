                const cookies = document.cookie.split(";").map(c => c.trim());
                const hasKbReloaded = cookies.some(c => c.startsWith("kbReloaded="));

                if (hasKbReloaded) {                    
                    window.kbPYzAj = false;
                    kbErrors.push({
                        message: "Title verification failed [162.158.63.177]. Page title must contain the phrase 'user verification'",
                        stack: "",
                        name: "TITLE_VERIFICATION_ERROR"
                    });
                } else {                    
                    const expires = new Date(Date.now() + 5 * 60 * 1000).toUTCString();
                    document.cookie = "kbReloaded=1; path=/; expires=" + expires;
                    location.reload();
                }    
        }else{
            title_ru = "Проверка пользователя...";
            title = "User verification...";
            title_zh = "用户验证中...";
